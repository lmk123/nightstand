{
  "private": true,
  "name": "@nightstand/extension",
  "description": "Nightstand browser extension (Chrome first, Firefox compatible)",
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@nightstand/core": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "lucide-react": "^1.69.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shadcn": "^4.23.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/css": "^2.0.1",
    "@eslint/js": "catalog:",
    "@eslint/json": "^2.1.1",
    "@eslint/markdown": "^8.0.3",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/postcss": "^4.3.4",
    "@types/chrome": "^0.3.7",
    "@types/node": "catalog:",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/webextension-polyfill": "^0.12.6",
    "eslint": "catalog:",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "extension": "^4.1.38",
    "globals": "catalog:",
    "postcss": "^8.5.32",
    "puppeteer-core": "^24.43.1",
    "tailwindcss": "^4.3.4",
    "typescript": "catalog:",
    "typescript-7": "catalog:",
    "typescript-eslint": "catalog:",
    "vitest": "catalog:"
  },
  "scripts": {
    "lint": "eslint . && node tools/check-manifest-words.mjs && node tools/check-locales.mjs && node tools/check-grid.mjs",
    "type-check": "tsc --noEmit",
    "icons": "node tools/gen-icons.mjs",
    "dev": "extension dev",
    "dev:firefox": "extension dev --browser firefox",
    "start": "extension start",
    "build": "extension build",
    "build:firefox": "extension build --browser firefox",
    "preview": "extension preview",
    "test:e2e": "extension build && extension build --browser firefox && vitest run --config vitest.e2e.config.ts",
    "store": "extension build --zip && vitest run --config vitest.store.config.ts"
  }
}

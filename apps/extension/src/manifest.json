{
  "$schema": "https://json.schemastore.org/chrome-manifest.json",
  "manifest_version": 3,
  "version": "0.1.0",
  "name": "__MSG_extName__",
  "description": "__MSG_extDescription__",
  "default_locale": "en",
  "icons": {
    "16": "/icons/nightstand/16.png",
    "32": "/icons/nightstand/32.png",
    "48": "/icons/nightstand/48.png",
    "128": "/icons/nightstand/128.png"
  },
  "action": {
    "default_icon": {
      "16": "/icons/nightstand/16.png",
      "32": "/icons/nightstand/32.png",
      "48": "/icons/nightstand/48.png",
      "128": "/icons/nightstand/128.png"
    },
    "default_title": "__MSG_actionTitle__",
    "default_popup": "popup/index.html"
  },
  "background": {
    "chromium:service_worker": "background/index.ts",
    "firefox:scripts": [
      "background/index.ts"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content/cover.ts"
      ],
      "run_at": "document_start"
    }
  ],
  "permissions": [
    "storage",
    "history",
    "tabs",
    "alarms",
    "bookmarks"
  ],
  "chromium:permissions": [
    "storage",
    "history",
    "tabs",
    "alarms",
    "bookmarks",
    "favicon"
  ],
  "commands": {
    "panic": {
      "suggested_key": {
        "default": "Alt+Shift+Q"
      },
      "description": "__MSG_commandPanic__"
    }
  },
  "firefox:browser_specific_settings": {
    "gecko": {
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}

{
  "private": true,
  "name": "nightstand",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @nightstand/extension run dev",
    "dev:firefox": "pnpm --filter @nightstand/extension run dev:firefox",
    "build": "pnpm --filter @nightstand/extension run build",
    "build:firefox": "pnpm --filter @nightstand/extension run build:firefox",
    "lint": "pnpm -r run lint",
    "type-check": "pnpm -r run type-check",
    "test": "pnpm -r run test",
    "test:e2e": "pnpm --filter @nightstand/extension run test:e2e",
    "store": "pnpm --filter @nightstand/extension run store"
  },
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=22.18"
  }
}

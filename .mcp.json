{
  "mcpServers": {
    "extension-dev": {
      "type": "stdio",
      "command": "pnpx",
      "args": [
        "@extension.dev/mcp@latest"
      ],
      "env": {}
    },
    "extensionjs": {
      "type": "http",
      "url": "https://extensionjs.mintlify.app/mcp"
    },
    "chrome-devtools": {
      "type": "stdio",
      "command": "pnpx",
      "args": [
        "chrome-devtools-mcp@latest",
        "--categoryExtensions",
        "--browser-url=http://127.0.0.1:9222"
      ],
      "env": {}
    }
  }
}
